# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data (synthetic data is regenerated by scripts, not committed in bulk)
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
data/external/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Database
db/*.db
db/*.sqlite3

# ML artifacts
mlruns/*
!mlruns/.gitkeep
models/*.joblib
models/*.json
!models/.gitkeep

# Env / secrets
.env
*.env.local

# OS / editor
.DS_Store
.vscode/
.idea/
